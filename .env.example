# Optional. Tik: RCFO needs no configuration; this is the only setting it reads (from the environment).
#   macOS/Linux:  export TIK_RCFO_HOME=/path      Windows (PowerShell):  $env:TIK_RCFO_HOME = "D:\tik-rcfo"
# Where the program keeps everything (Android emulator, virtual phone, downloads). Default: ~/.tik-rcfo
# Use a path without spaces. "Erase all program data" deletes exactly this folder.
TIK_RCFO_HOME=~/.tik-rcfo
