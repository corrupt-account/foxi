# Optional. foxi needs no configuration; these are the only settings it reads (from the environment).
#   macOS/Linux:  export FOXI_HOME=/path        Windows (PowerShell):  $env:FOXI_HOME = "C:\foxi-data"

# Where foxi keeps everything it creates (Android emulator, virtual phone, downloads). Default: ~/.foxi
# Use a path without spaces. "Close program and erase all program data" deletes exactly this folder.
FOXI_HOME=~/.foxi

# Set to 0 to print tiktok.com/@rcfo and the credits as plain text instead of clickable links.
FOXI_LINKS=1
